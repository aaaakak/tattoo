{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "entrypoint": "config.wsgi:application",
      "framework": "django",
      "buildCommand": "python manage.py collectstatic --noinput --settings=config.settings.build"
    },
    "api": {
      "root": "./",
      "entrypoint": "api_service.main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
