# ---------------------------------------------------------------------------
# TattoWeb environment -- copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Django
# ---------------------------------------------------------------------------
# DEBUG must be False in production. Note that for the *servers* the settings
# module is selected by DJANGO_SETTINGS_MODULE, not by this file: production
# runs with config.settings.prod, which forces DEBUG=False and refuses to start
# if DJANGO_SECRET_KEY or ALLOWED_HOSTS are missing. See README.
DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_NAME=TattoWeb
SITE_TIMEZONE=Europe/Berlin

# Database (PostgreSQL 15)
# ---------------------------------------------------------------------------
# One schema, owned by Django migrations. FastAPI reads it and never issues DDL.
DATABASE_URL=postgres://USER@127.0.0.1:5432/tattoweb

# API service layer (FastAPI)
# ---------------------------------------------------------------------------
# CORS is an explicit allow-list for cross-origin browser calls. In production
# one reverse proxy fronts both stacks, so the frontend is same-origin and this
# list should be empty or limited to the real public origin -- never "*".
FASTAPI_BASE_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Uploads
# ---------------------------------------------------------------------------
# Enforced server-side; the client-side check is advisory only.
# Default 12. Leave the value out, or leave it empty, to use the default -- an empty
# optional value is treated as "not supplied", so it will not crash the settings import.
IMAGE_MAX_UPLOAD_MB=12

# NOTE for hosting platforms: do not define optional variables as empty strings. An empty
# value is now handled safely, but the cleanest configuration is simply to omit the
# variable. See docs/deployment.md.

# Email (optional -- booking notifications log to console when unset)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=studio@example.com

# Internal reference page: /design-system/ (staff-only, 404s when disabled)
# ---------------------------------------------------------------------------
# Defaults to DEBUG. Set False in production to keep the route entirely absent.
DESIGN_SYSTEM_ENABLED=True

# Static asset cache-busting stamp (dev only -- production uses manifest hashes)
# ---------------------------------------------------------------------------
STATIC_VERSION=dev1

# Media storage root. Defaults to <project>/media, which is fine for a single
# host; set an absolute path when uploads live outside the release directory.
# ---------------------------------------------------------------------------
# MEDIA_ROOT=/srv/tattoweb/media

# Rate limiting (django-ratelimit) -- booking, contact and concept are the
# abuse surfaces. Leave enabled in production.
# ---------------------------------------------------------------------------
RATELIMIT_ENABLE=True

# Production hardening (applied by config.settings.prod, which forces DEBUG=False)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Comma-separated full origins with scheme, e.g. https://tattoo.example.com
CSRF_TRUSTED_ORIGINS=

# Media storage -- Supabase Storage (S3-compatible)
# ---------------------------------------------------------------------------
# Leave ALL FOUR unset and media is written to MEDIA_ROOT on disk, which is
# what local development wants. Set all four and uploads go to Supabase
# instead, which production needs because the Vercel filesystem is read-only
# apart from an ephemeral /tmp: a file written there does not survive the
# request that created it.
#
# All four are required together. A partial set is ignored on purpose, so a
# half-configured deployment falls back to disk rather than failing at the
# first upload with an opaque storage error.
#
# Values come from the Supabase dashboard:
#   endpoint   Project Settings -> Storage -> S3 connection -> endpoint
#   keys       Project Settings -> Storage -> S3 access keys
#   bucket     the bucket you created for uploads (must exist)
# ---------------------------------------------------------------------------
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_BUCKET=media
# Region is required by the SDK but not meaningful -- the endpoint decides where
# the request goes. Supabase documents us-east-1 for its S3 gateway.
# SUPABASE_S3_REGION=us-east-1
#
# Public read base for the bucket, used for MEDIA_URL. Omit it and URLs are
# generated against the endpoint; set it when the bucket is public so image
# tags point straight at the CDN path and do not need signed URLs (which would
# expire and break already-published pages).
# SUPABASE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
